#include "cache.h"
#include <unordered_map>
#include <vector>

#define NUM_IP_ENTRIES 24
#define NUM_PATTERNS 24
#define HISTORY_LEN 8

#define NO_CONF 0
#define MID_CONF 1
#define HIGH_CONF 2

#define ACC_HIGH 0.75
#define ACC_LOW 0.25
#define MAX_DEGREE 4
#define MIN_DEGREE 1

typedef uint64_t ip_t;

struct Vector_Hash {
    size_t operator()(const vector<int64_t> &vec) const {
        size_t h = vec.size();
        for (int64_t x : vec)
            h ^= std::hash<int64_t>{}(x) + 0x9e3779b9 + (h << 6) + (h >> 2);
        return h;
    }
};

struct IP_P_Entry {
    int64_t next_stride;
    int64_t confidence;

    IP_P_Entry(int64_t stride) {
        next_stride = stride;
        confidence = 0;
    }
};

struct IP_Entry {
    uint64_t last_addr;
    vector<int64_t> last_strides;
    uint8_t confidence;
    uint8_t LRU;
    int64_t monitored_stride;

    unordered_map<vector<int64_t>, IP_P_Entry, Vector_Hash> patterns;

    IP_Entry(uint64_t addr) {
        last_strides.assign(HISTORY_LEN, 0);
        this->LRU = 0;
        this->confidence = 0;
        this->monitored_stride = 0;
        this->last_addr = addr;
    }
};

unordered_map<ip_t, IP_Entry> g_ip_table;
int g_prefetch_degree = 1;
uint64_t epoch_accesses = 0;
uint64_t g_last_issued = 0, g_last_useful = 0;

void evict_lru_ip() {
    if (g_ip_table.size() < NUM_IP_ENTRIES)
        return;

    auto victim = g_ip_table.begin();
    for (auto it = g_ip_table.begin(); it != g_ip_table.end(); ++it) {
        if (it->second.LRU > victim->second.LRU)
            victim = it;
    }
    g_ip_table.erase(victim);
}

void evict_least_confident_pattern(IP_Entry &entry) {
    auto &the_map = entry.patterns;
    if (the_map.size() < NUM_PATTERNS)
        return;

    auto it = the_map.begin();
    int64_t min_confidence = INT64_MAX;
    auto to_delete = it;
    for (; it != the_map.end(); it++) {
        if (it->second.confidence < min_confidence) {
            min_confidence = it->second.confidence;
            to_delete = it;
        }
    }
    the_map.erase(to_delete);
}

int64_t calculate_stride(uint64_t curr_addr, uint64_t last_addr) {
    if (curr_addr > last_addr)
        return (int64_t)(curr_addr - last_addr);
    else
        return -1 * (int64_t)(last_addr - curr_addr);
}

void adjust_prefetch_degree(uint64_t pf_issued, uint64_t pf_useful) {
    uint64_t issued = pf_issued - g_last_issued;
    uint64_t useful = pf_useful - g_last_useful;
    g_last_issued = pf_issued;
    g_last_useful = pf_useful;

    if (issued == 0)
        return; // nothing to judge this epoch

    double accuracy = (double)useful / issued;
    if (accuracy > ACC_HIGH && prefetch_degree < MAX_DEGREE)
        g_prefetch_degree++;
    else if (accuracy < ACC_LOW && g_prefetch_degree > MIN_DEGREE)
        g_prefetch_degree--;
}

vector<uint64_t> find_prefetch_targets(IP_Entry &entry, uint64_t cl_addr, int degree) {
    vector<int64_t> strides = entry.last_strides;
    for (int i = 0; i < degree; i++) {
        // TODO
    }
}

void CACHE::l1d_prefetcher_initialize() {
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag) {
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

    auto it = g_ip_table.find(ip);
    if (it == g_ip_table.end()) {
        evict_lru_ip();
        g_ip_table.emplace(ip, IP_Entry(cl_addr));
    } else {
        IP_Entry &entry = it->second;
        int64_t stride = calculate_stride(cl_addr, entry.last_addr);

        // Train the constant stride prefetcher
        if (stride == entry.monitored_stride && entry.confidence < HIGH_CONF)
            entry.confidence++;
        else if (stride != entry.monitored_stride && entry.confidence == MID_CONF)
            entry.confidence--;
        else if (stride != entry.monitored_stride && entry.confidence == NO_CONF)
            entry.monitored_stride = stride;

        // Train the variable stride prefetcher
        auto itp = entry.patterns.find(entry.last_strides);
        if (itp == entry.patterns.end()) {
            evict_least_confident_pattern(entry);
            entry.patterns.emplace(entry.last_strides, IP_P_Entry(stride));
        } else {
            if (itp->second.next_stride == stride)
                itp->second.confidence++;
            else
                itp->second.confidence--;
        }

        entry.last_strides.erase(entry.last_strides.begin());
        entry.last_strides.push_back(stride);
        entry.last_addr = cl_addr;
        adjust_prefetch_degree(pf_issued, pf_useful);

        if (it->second.confidence == HIGH_CONF) {
            // Prefetch using the constant stride data
            for (int d = 1; d < g_prefetch_degree; g++) {
                uint64_t tgt = (cl_addr + d * stride) << LOG2_BLOCK_SIZE;
                if ((tgt >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
                    break;
                if (MSHR.occupancy < (MSHR.SIZE >> 1))
                    prefetch_line(ip, addr, tgt, FILL_L1, 0);
                else
                    prefetch_line(ip, addr, tgt, FILL_L2, 0);
            }
        } else {
            // Prefetch using variable stride data TODO
            vector<uint64_t> tgts = find_prefetch_targets(entry, cl_addr, g_prefetch_degree);
        }
    }
}


#include "cache.h"

// Basic IP-based stride prefetcher with a fixed prefetch distance.
//
// For every load IP we remember the last cache line it touched and the last
// stride it saw. Once the same stride is observed twice in a row, we issue
// PREFETCH_DEGREE prefetches starting PREFETCH_DISTANCE strides ahead:
//
//     cl_addr + stride * (PREFETCH_DISTANCE + i),  i = 0 .. PREFETCH_DEGREE-1

#define IP_TABLE_SIZE 64
#define PREFETCH_DISTANCE 4
#define PREFETCH_DEGREE 1

class IP_ENTRY {
  public:
    // the IP we're tracking (full IP, no masking, to avoid aliasing)
    uint64_t ip;

    // the last cache line address accessed by this IP
    uint64_t last_cl_addr;

    // the stride between the last two cache lines accessed by this IP
    int64_t last_stride;

    // LRU position (0 = most recently used)
    uint32_t lru;

    bool valid;

    IP_ENTRY () {
        ip = 0;
        last_cl_addr = 0;
        last_stride = 0;
        lru = 0;
        valid = false;
    };
};

IP_ENTRY ip_table[IP_TABLE_SIZE];

uint64_t stride_pf_issued = 0;

static void update_lru(int index)
{
    for (int i=0; i<IP_TABLE_SIZE; i++) {
        if (ip_table[i].lru < ip_table[index].lru)
            ip_table[i].lru++;
    }
    ip_table[index].lru = 0;
}

void CACHE::l1d_prefetcher_initialize()
{
    cout << "CPU " << cpu << " L1D IP-based stride prefetcher (fixed distance)" << endl;
    for (int i=0; i<IP_TABLE_SIZE; i++)
        ip_table[i].lru = i;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

    // look up the IP in the table
    int index;
    for (index=0; index<IP_TABLE_SIZE; index++) {
        if (ip_table[index].valid && ip_table[index].ip == ip)
            break;
    }

    // new IP: replace the LRU entry and start training
    if (index == IP_TABLE_SIZE) {
        for (index=0; index<IP_TABLE_SIZE; index++) {
            if (ip_table[index].lru == (IP_TABLE_SIZE-1))
                break;
        }
        assert(index < IP_TABLE_SIZE);

        ip_table[index].ip = ip;
        ip_table[index].last_cl_addr = cl_addr;
        ip_table[index].last_stride = 0;
        ip_table[index].valid = true;
        update_lru(index);
        return;
    }

    // signed stride between the current and the last cache line
    int64_t stride = (int64_t)cl_addr - (int64_t)ip_table[index].last_cl_addr;

    // same line accessed again: nothing to learn
    if (stride == 0) {
        update_lru(index);
        return;
    }

    // stride confirmed twice in a row: prefetch PREFETCH_DISTANCE strides ahead
    if (stride == ip_table[index].last_stride) {
        for (int i=0; i<PREFETCH_DEGREE; i++) {
            uint64_t pf_address = (cl_addr + stride * (PREFETCH_DISTANCE + i)) << LOG2_BLOCK_SIZE;

            // stay within the 4 KB page of the demand access
            if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
                break;

            // fill into L1 unless the MSHR is getting full, then fill into L2
            if (MSHR.occupancy < (MSHR.SIZE>>1))
                prefetch_line(ip, addr, pf_address, FILL_L1, 0);
            else
                prefetch_line(ip, addr, pf_address, FILL_L2, 0);
            stride_pf_issued++;
        }
    }

    ip_table[index].last_cl_addr = cl_addr;
    ip_table[index].last_stride = stride;
    update_lru(index);
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
}

void CACHE::l1d_prefetcher_final_stats()
{
    cout << "CPU " << cpu << " L1D IP-based stride prefetcher (fixed distance) final stats" << endl;
    cout << "Table size: " << IP_TABLE_SIZE << " Distance: " << PREFETCH_DISTANCE << " Degree: " << PREFETCH_DEGREE << endl;
    cout << "Prefetches generated: " << stride_pf_issued << endl;
}
